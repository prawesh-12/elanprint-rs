# ELAN 04f3:0c90 fingerprint sensor. Userspace driver, no kernel module.
# uaccess grants the ACL to the active local seat user. MODE alone would not:
# without a GROUP the group stays root.
#
# Install with a targeted trigger, never a bare `udevadm trigger`:
#   sudo cp udev/70-elanmoc.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=04f3
# A bare trigger re-events every device on the machine, and uaccess applies
# most reliably on add.
SUBSYSTEM=="usb", ATTRS{idVendor}=="04f3", ATTRS{idProduct}=="0c90", MODE="0660", TAG+="uaccess"
